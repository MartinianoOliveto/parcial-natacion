import cursos.*
import docente.*
import estilos.*
import estudiantes.*

describe "Natacion"{
   const debi = new DocenteBasico(esGuardavida=false)
   const isa = new DocenteBasico(esGuardavida=true)
   const nico = new Dedicado(estilo=pecho,esGuardavida=false)
   const mara = new Externo(limiteMenores=2,esGuardavida=false)

   const milena = new Estudiante(edad=10,estilosDominados=#{crol,pecho})
   const rodrigo = new Estudiante(edad=9,estilosDominados=#{mariposa,pecho})
   const matilda = new Estudiante(edad=9,estilosDominados=#{crol,pecho})
   const elias = new Estudiante(edad=15)
   const camilo = new Estudiante(edad=16,estilosDominados=#{crol,pecho,espalda})
   const juana = new Estudiante(edad=16,estilosDominados=#{crol})

   const martes = new CursoBase(docente=debi,cupo=3,estudiantesInscriptos=#{milena,rodrigo})
   const jueves = new CursoBase(docente=isa,cupo=3,estudiantesInscriptos=#{milena,rodrigo})
   const viernes = new CursoBase(docente=nico,cupo=3,estudiantesInscriptos=#{milena,rodrigo})
   const colonia = new Escuelita(docente=debi,cupo=3,estudiantesInscriptos=#{milena,rodrigo})
   const rehabilitacion = new Terapeutico(docente=mara,cupo=4,estudiantesInscriptos=#{milena,camilo},recaudacionBruta=300)

   test"Milena no puede inscribirse al curso de los martes, ya esta inscripta"{
      assert.notThat(martes.puedeInscribirse(milena))
   }
   test"Matilda y Camilo si pueden inscribirse al curso de los martes"{
      assert.that(martes.puedeInscribirse(matilda))
      assert.that(martes.puedeInscribirse(camilo))
   }
   test"Elias no puede inscribirse al curso de los martes"{
      assert.notThat(martes.puedeInscribirse(elias))
   }
   test"No puedo inscribir a elias a los martes"{
      assert.throwsException({martes.inscribir(elias)})
   }
   test"Inscribir a Matilda a los martes, Camilo no puede por falta de cupo"{
      martes.inscribir(matilda)
      assert.equals(#{milena,rodrigo,matilda},martes.estudiantesInscriptos())
      assert.throwsException({martes.inscribir(camilo)})
   }
   test "Elias puede inscribirse a los jueves"{
      assert.that(jueves.puedeInscribirse(elias))
   }
   test"Curso basico docente dedicado"{
      assert.notThat(viernes.puedeInscribirse(milena))
      assert.that(viernes.puedeInscribirse(matilda))
      assert.that(viernes.puedeInscribirse(camilo))
      assert.notThat(viernes.puedeInscribirse(juana))
      assert.throwsException({viernes.puedeInscribir(juana)})
      viernes.inscribir(matilda)
      assert.equals(#{milena,rodrigo,matilda},viernes.estudiantesInscriptos())
      assert.notThat(viernes.puedeInscribirse(camilo))
      assert.throwsException({viernes.puedeInscribir(camilo)})
   }
   test"Escuela de niños"{
      assert.that(colonia.puedeInscribirse(matilda))
      assert.notThat(colonia.puedeInscribirse(camilo))
      assert.notThat(colonia.puedeInscribirse(elias))
      assert.throwsException({colonia.puedeInscribir(camilo)})
      assert.throwsException({colonia.puedeInscribir(elias)})
      colonia.inscribir(matilda)
      assert.equals(#{milena,rodrigo,matilda},colonia.estudiantesInscriptos())
   }
   test"Terapeutico docente externo"{
      assert.notThat(rehabilitacion.puedeInscribirse(milena))
      assert.notThat(rehabilitacion.puedeInscribirse(juana))
      assert.that(rehabilitacion.puedeInscribirse(matilda))
      assert.that(rehabilitacion.puedeInscribirse(rodrigo))
      rehabilitacion.inscribir(matilda)
      assert.throwsException({rehabilitacion.inscribir(rodrigo)})
      assert.equals(#{milena,camilo,matilda},rehabilitacion.estudiantesInscriptos())
   }

}